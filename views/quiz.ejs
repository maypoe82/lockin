<%- include('partials/header') %>
<div class="page-head">
  <div>
    <span class="pill"><%= material.module_code %></span>
    <h1><%= heading %></h1>
    <p class="muted"><%= questions.length %> questions<%= mode === 'lockin' ? ' · selected from questions you have not yet answered correctly' : '' %></p>
  </div>
</div>
<form action="/quiz/submit" method="POST" class="quiz" id="quiz-form">
  <% questions.forEach((q, i) => { %>
    <fieldset class="card question">
      <legend>Question <%= i + 1 %> · <%= q.difficulty %></legend>
      <p class="q-text"><%= q.question %></p>
      <% q.options.forEach((opt, j) => { %>
        <label class="option">
          <input type="radio" name="q_<%= q.id %>" value="<%= j %>" required>
          <span class="opt-letter"><%= 'ABCD'[j] %></span><span><%= opt %></span>
        </label>
      <% }) %>
    </fieldset>
  <% }) %>
  <button class="btn btn-big">Submit answers</button>
</form>
<%- include('partials/footer') %>
