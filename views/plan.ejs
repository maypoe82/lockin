<%- include('partials/header') %>
<div class="page-head"><div><h1>Revision Plan</h1><p class="lead">Focus on topics below the 60% target. Tick off each step as you complete it.</p></div></div>
<% if (!totalTopics) { %>
  <div class="card center"><p class="muted">No topics yet.</p><a href="/upload" class="btn">Upload notes</a></div>
<% } else if (!plan.length) { %>
  <div class="card center"><h2>No topics below target</h2><p class="muted">Every assessed topic is at or above 60%. Take more quizzes to keep your results current.</p><a href="/materials" class="btn">Go to my notes</a></div>
<% } %>
<% plan.forEach(p => { %>
  <section class="card plan" data-plan="<%= p.topic.id %>">
    <div class="topic-head">
      <div><span class="pill"><%= p.topic.module_code %></span><h2><%= p.topic.name %></h2></div>
      <span class="pill pill-weak"><%= p.topic.score %>% mastery</span>
    </div>
    <ol class="steps">
      <% p.steps.forEach((s, i) => { %>
        <li><label><input type="checkbox" data-step="<%= p.topic.id %>-<%= i %>"><a href="<%= s.href %>"><%= s.label %></a></label></li>
      <% }) %>
    </ol>
  </section>
<% }) %>
<%- include('partials/footer') %>
