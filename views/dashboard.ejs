<%- include('partials/header') %>
<section class="dash-head">
  <p class="eyebrow">Overview</p>
  <h1><%= greeting %>, <%= user.name %></h1>
  <% if (materialCount) { %>
  <p class="lead">
    <% if (weak.length) { %><strong><%= weak.length %></strong> topic<%= weak.length > 1 ? 's are' : ' is' %> below the 60% target. See your <a href="/plan">Revision Plan</a>.
    <% } else if (untested) { %><strong><%= untested %></strong> topic<%= untested > 1 ? 's have' : ' has' %> not been assessed yet. Take a quiz to measure your understanding.
    <% } else { %>All assessed topics are at or above the 60% target.<% } %>
  </p>
  <% } %>
</section>

<% if (!materialCount) { %>
  <%# New user: only show what to do next %>
  <section class="card onboarding">
    <h2>Get started</h2>
    <p class="muted">Three steps to your first revision plan.</p>
    <ol class="checklist">
      <% onboarding.forEach(s => { %>
        <li class="<%= s.done ? 'done' : '' %>"><span class="check" aria-hidden="true"></span><%= s.label %></li>
      <% }) %>
    </ol>
    <a href="/upload" class="btn">Upload lecture notes</a>
  </section>
<% } else { %>

<section class="today">
  <div class="card today-item">
    <div><small class="eyebrow">Flashcards due</small><strong class="num"><%= dueCards %></strong></div>
    <% if (dueCards) { %><a href="/review" class="btn btn-small">Review now</a><% } else { %><span class="muted">All caught up</span><% } %>
  </div>
  <div class="card today-item">
    <div><small class="eyebrow">Next exam</small>
      <% if (upcoming) { %><strong><%= upcoming.code %></strong> <span class="muted">in <%= upcoming.days %> day<%= upcoming.days === 1 ? '' : 's' %></span><% } else { %><span class="muted">Not set</span><% } %></div>
    <a href="/plan" class="btn btn-small btn-ghost"><%= upcoming ? 'View schedule' : 'Add exam date' %></a>
  </div>
</section>

<section class="stats stats-3">
  <div class="stat card"><small>Average mastery</small><strong><%= stats.questionsAnswered ? knowledge + '%' : '—' %></strong></div>
  <div class="stat card"><small>Study time</small><strong><%= stats.studyTime %></strong></div>
  <div class="stat card"><small>Day streak</small><strong><%= stats.streak.count %></strong></div>
</section>

<div class="grid-2">
  <section class="card">
    <h2>Topic mastery</h2>
    <% for (const [code, list] of Object.entries(modules)) { %>
      <h3 class="module"><%= code %></h3>
      <% list.forEach(t => { %><%- include('partials/bar', { t }) %><% }) %>
    <% } %>
    <div class="legend"><span><i class="bar-strong"></i>80% and above</span><span><i class="bar-ok"></i>60–79%</span><span><i class="bar-weak"></i>Below 60%</span><span><i class="bar-new"></i>Not assessed</span></div>
    <% if (opp) { %>
      <div class="opp"><span>Weakest topic: <strong><%= opp.name %></strong> (<%= opp.score %>%)</span>
        <a href="/plan" class="btn btn-small">Review</a></div>
    <% } %>
  </section>

  <section class="card">
    <div class="section-head"><h2>Recent quizzes</h2><% if (recent.length) { %><a href="/progress" class="muted">View progress</a><% } %></div>
    <% if (!recent.length) { %>
      <p class="muted">No quizzes taken yet.</p>
      <a href="/materials" class="btn btn-small">Take a quiz</a>
    <% } %>
    <ul class="list">
      <% recent.forEach(r => { const p = r.total ? Math.round(r.score / r.total * 100) : 0; %>
        <li><a href="/quiz/result/<%= r.id %>"><%= r.title %><%= r.mode === 'lockin' ? ' (practice)' : '' %></a>
          <span class="pill <%= p >= 80 ? 'pill-strong' : p < 60 ? 'pill-weak' : '' %>"><%= r.score %>/<%= r.total %></span></li>
      <% }) %>
    </ul>
  </section>
</div>
<% } %>
<%- include('partials/footer') %>
