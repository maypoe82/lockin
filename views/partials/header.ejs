<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="LockIn turns lecture notes into explanations, flashcards and quizzes, then builds a revision plan around your weak topics.">
  <title><%= title %> · LockIn</title>
  <script nonce="<%= nonce %>">
    // Apply the saved theme (or the device setting) before the page paints
    (function () {
      var t = null;
      try { t = localStorage.getItem('lockin-theme'); } catch (e) {}
      if (!t) t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body<% if (typeof studyPage !== 'undefined' && studyPage) { %> data-study="1"<% } %> data-csrf="<%= csrfToken %>">
  <a href="#main" class="skip-link">Skip to content</a>
  <nav class="nav" aria-label="Main">
    <a href="/" class="logo">Lock<span>In</span></a>
    <button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <div class="nav-links" id="nav-links">
      <% if (user) { %>
        <a href="/" class="<%= path === '/' ? 'active' : '' %>">Dashboard</a>
        <a href="/materials" class="<%= path.startsWith('/materials') ? 'active' : '' %>">My notes</a>
        <a href="/review" class="<%= path === '/review' ? 'active' : '' %>">Flashcards</a>
        <a href="/plan" class="<%= path === '/plan' ? 'active' : '' %>">Revision Plan</a>
        <a href="/progress" class="<%= path === '/progress' ? 'active' : '' %>">Progress</a>
        <a href="/upload" class="btn btn-small">Upload</a>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/register" class="btn btn-small">Sign up</a>
      <% } %>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between light and dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <span id="theme-label">Dark mode</span>
      </button>
      <% if (user) { %><form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-btn">Log out</button></form><% } %>
    </div>
  </nav>
  <% if (aiMode === 'mock' && user) { %>
    <div class="banner">Demo mode: add a <code>GEMINI_API_KEY</code> to enable AI-generated content.</div>
  <% } %>
  <main class="container" id="main" tabindex="-1">
  <% if (flash) { %><div class="flash flash-<%= flash.type %>" role="status"><%= flash.msg %><button type="button" class="flash-close" aria-label="Dismiss">&times;</button></div><% } %>
