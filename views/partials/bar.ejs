<% const s = t.score; const cls = s === null ? 'new' : s >= 80 ? 'strong' : s < 60 ? 'weak' : 'ok'; %>
<div class="bar-row">
  <span class="bar-label"><%= t.name %></span>
  <div class="bar"><div class="bar-fill bar-<%= cls %>" style="width: <%= s || 0 %>%"></div></div>
  <span class="bar-val mono"><%= s === null ? '—' : s + '%' %> <%= cls === 'strong' ? '🔥' : cls === 'weak' ? '💀' : '' %></span>
</div>
