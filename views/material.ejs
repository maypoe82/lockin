<%- include('partials/header', { studyPage: true }) %>
<div class="page-head">
  <div>
    <span class="pill"><%= material.module_code %></span>
    <h1><%= material.title %></h1>
    <p class="lead"><%= material.summary %></p>
  </div>
  <a href="/quiz/material/<%= material.id %>" class="btn">Take quiz</a>
</div>

<nav class="topic-jump" aria-label="Topics in this material">
  <span class="muted">Topics:</span>
  <% topics.forEach(t => { %><a href="#topic-<%= t.id %>" data-jump><%= t.name %></a><% }) %>
</nav>

<div class="tabs" role="tablist">
  <button class="tab active" data-tab="learn">Explanation</button>
  <button class="tab" data-tab="brainrot">Brainrot mode</button>
  <button class="tab" data-tab="notes">Key points</button>
  <button class="tab" data-tab="cards">Flashcards (<%= flashcards.length %>)</button>
</div>

<% ['learn', 'brainrot', 'notes'].forEach(mode => { %>
<section class="panel <%= mode === 'learn' ? '' : 'hidden' %>" data-panel="<%= mode %>">
  <% topics.forEach(t => { const s = t.stats; %>
    <article class="card topic" id="<%= mode === 'learn' ? 'topic-' + t.id : '' %>">
      <div class="topic-head">
        <h2><%= t.name %></h2>
        <% if (s && s.score !== null) { %>
          <span class="pill <%= s.status === 'strong' ? 'pill-strong' : s.status === 'weak' ? 'pill-weak' : '' %>"><%= s.score %>% mastery</span>
        <% } else { %><span class="pill">Not assessed</span><% } %>
      </div>
      <% if (mode === 'learn') { %><p><%= t.learn %></p><% } %>
      <% if (mode === 'brainrot') { %><p class="brainrot"><%= t.brainrot %></p><% } %>
      <% if (mode === 'notes') { %><ul class="notes"><% t.notes.forEach(n => { %><li><%= n %></li><% }) %></ul><% } %>
      <% if (s && s.status === 'weak') { %>
        <a class="btn btn-small" href="/quiz/lockin?topic=<%= t.id %>&difficulty=easy">Practise this topic</a>
      <% } %>
    </article>
  <% }) %>
</section>
<% }) %>

<section class="panel hidden" data-panel="cards">
  <% if (!flashcards.length) { %><p class="muted">No flashcards for this material.</p><% } else { %>
    <%- include('partials/deck', { cards: flashcards }) %>
  <% } %>
</section>
<%- include('partials/footer') %>
