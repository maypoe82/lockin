<%- include('partials/header') %>
<section class="card">
  <p class="eyebrow"><%= attempt.module_code %> · <%= attempt.mode === 'lockin' ? 'Practice quiz' : 'Assessment' %></p>
  <h1 class="score"><%= attempt.score %>/<%= attempt.total %> <span class="muted">(<%= pct %>%)</span></h1>
  <p class="lead"><%= pct >= 80 ? 'Strong result. Keep reviewing to maintain it.' : pct >= 60 ? 'Satisfactory. Some topics still need review.' : 'Below target. Review the topics highlighted below.' %></p>
</section>

<% alerts.forEach(a => { %>
  <div class="alert card">
    <h2>Revision recommended: <%= a.name %></h2>
    <p>You answered <strong><%= a.wrong %></strong> <%= a.name %> question<%= a.wrong > 1 ? 's' : '' %> incorrectly. Suggested revision time: <strong><%= a.minutes %> minutes</strong>.</p>
    <div class="row-actions">
      <a class="btn btn-small" href="/materials/<%= attempt.material_id %>#topic-<%= a.id %>">Review <%= a.name %></a>
      <a class="btn btn-small btn-ghost" href="/quiz/lockin?topic=<%= a.id %>&difficulty=easy">Practise 5 easy questions</a>
    </div>
  </div>
<% }) %>

<section class="card">
  <h2>Results by topic</h2>
  <% topics.forEach(t => { %><%- include('partials/bar', { t: { name: `${t.name} (${t.right}/${t.total})`, score: t.pct } }) %><% }) %>
</section>

<section>
  <h2>Answer review</h2>
  <% rows.forEach((r, i) => { %>
    <div class="card review <%= r.correct ? 'review-right' : 'review-wrong' %>">
      <p class="muted">Question <%= i + 1 %> · <%= r.topic %> · <%= r.difficulty %></p>
      <p class="q-text"><%= r.question %></p>
      <ul class="answers">
        <% r.options.forEach((o, j) => { %>
          <li class="<%= j === r.answer_index ? 'ans-right' : j === r.chosen_index ? 'ans-wrong' : '' %>"><%= 'ABCD'[j] %>. <%= o %><% if (j === r.answer_index) { %><span class="tag tag-right">Correct answer</span><% } else if (j === r.chosen_index) { %><span class="tag tag-wrong">Your answer</span><% } %></li>
        <% }) %>
      </ul>
      <% if (r.explanation) { %><p class="explain"><strong>Explanation:</strong> <%= r.explanation %></p><% } %>
    </div>
  <% }) %>
</section>
<div class="row-actions"><a href="/plan" class="btn">View Revision Plan</a><a href="/" class="btn btn-ghost">Dashboard</a></div>
<%- include('partials/footer') %>
