<%- include('partials/header', { studyPage: true }) %>
<div class="page-head"><div><h1>Review mistakes</h1><p class="lead">Questions you answered incorrectly and have not yet answered correctly since.</p></div></div>
<% if (!mistakes.length) { %><div class="card center"><p class="muted">No outstanding mistakes.</p></div><% } %>
<% mistakes.forEach(r => { %>
  <div class="card review review-wrong">
    <p class="muted"><%= r.topic %> · <%= r.difficulty %></p>
    <p class="q-text"><%= r.question %></p>
    <ul class="answers">
      <% r.options.forEach((o, j) => { %>
        <li class="<%= j === r.answer_index ? 'ans-right' : j === r.chosen_index ? 'ans-wrong' : '' %>"><%= 'ABCD'[j] %>. <%= o %><% if (j === r.answer_index) { %><span class="tag tag-right">Correct answer</span><% } else if (j === r.chosen_index) { %><span class="tag tag-wrong">Your answer</span><% } %></li>
      <% }) %>
    </ul>
    <% if (r.explanation) { %><p class="explain"><strong>Explanation:</strong> <%= r.explanation %></p><% } %>
  </div>
<% }) %>
<% if (topicId && mistakes.length) { %><a class="btn" href="/quiz/lockin?topic=<%= topicId %>&difficulty=medium">Practise 5 medium questions</a><% } %>
<%- include('partials/footer') %>
