# Copy to .env and fill in.  cp .env.example .env

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
TZ=Asia/Singapore

# Database (docker-compose sets DB_HOST=db for you)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lockin
DB_USER=lockin
DB_PASSWORD=lockin

# AI - set ONE of these. With neither, LockIn runs in demo mode (no real AI).
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force a provider: gemini | openai | mock  (optional)
# AI_PROVIDER=

# Cloud database (TiDB Cloud / other hosted MySQL) needs an encrypted connection:
# DB_SSL=true

# Email for "Forgot password" (optional). Without these, reset links are printed in the server log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="LockIn <you@gmail.com>"
